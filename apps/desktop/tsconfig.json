{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "verbatimModuleSyntax": true,
    "isolatedModules": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false, "rootDir": "src", "outDir": "dist/app",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
