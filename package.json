{
  "name": "vibeanimate",
  "version": "0.0.0",
  "private": true,
  "description": "VibeAnimate architecture contracts and verification harness",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/research/*.test.mjs tests/prototypes/*.test.mjs tests/architecture/*.test.mjs",
    "check:research": "node scripts/check-research.mjs",
    "gate:phase-zero": "node scripts/check-research.mjs --gate",
    "check:matrix": "node scripts/feature-matrix.mjs --check",
    "generate:matrix": "node scripts/feature-matrix.mjs",
    "check:licenses": "node scripts/audit-dependencies.mjs",
    "check": "npm run check:research && npm run check:matrix && npm run check:licenses && npm run check:notices && npm run check:contracts && npm test",
    "benchmark:research": "node experiments/numerics/benchmark.mjs",
    "probe:rendering": "node experiments/rendering/server.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check && tsc -p tsconfig.contracts.json",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:notices": "node scripts/dependency-notices.mjs --check",
    "generate:notices": "node scripts/dependency-notices.mjs",
    "demo:contracts": "node scripts/demo-contracts.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "5.9.3"
  }
}
